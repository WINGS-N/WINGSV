<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?roundedCornerColor"
    app:expanded="false"
    app:expandable="false"
    app:title="@string/federation_row_donor_title">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/donor_progress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/donor_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- Те же карточки, что считают трафик на главной -->
            <LinearLayout
                android:id="@+id/donor_counters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:measureWithLargestChild="true"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/federation_donor_nodes_caption"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />

                        <TextView
                            android:id="@+id/donor_nodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?android:attr/textAppearanceLarge"
                            android:textColor="?android:textColorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/donor_nodes_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/federation_donor_given_caption"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />

                        <TextView
                            android:id="@+id/donor_given"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?android:attr/textAppearanceLarge"
                            android:textColor="?android:textColorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/donor_given_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Сколько лимита уже сожрано: та же полоса, что у трафика -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp">

                    <ProgressBar
                        android:id="@+id/donor_budget_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:minHeight="30dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_profile_quota" />

                    <TextView
                        android:id="@+id/donor_budget_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:shadowColor="#B3000000"
                        android:shadowRadius="4"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <dev.oneuiproject.oneui.widget.Separator
                android:id="@+id/donor_nodes_separator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/federation_donor_nodes_section"
                android:visibility="gone" />

            <!-- Сюда складываются карточки серверов -->
            <LinearLayout
                android:id="@+id/donor_node_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Индикатор внутри самой кнопки: крутилка наверху экрана не говорит
                 ничего о том, что нажали именно тут -->
            <FrameLayout
                android:id="@+id/donor_connect_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/donor_connect"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/federation_donor_connect" />

                <ProgressBar
                    android:id="@+id/donor_connect_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="20dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</dev.oneuiproject.oneui.layout.ToolbarLayout>
