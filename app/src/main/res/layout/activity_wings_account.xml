<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?roundedCornerColor"
    app:expanded="false"
    app:expandable="false"
    app:title="@string/wings_account_title">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Вход -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/federation_sign_in_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp"
                app:roundedCorners="all">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/samsungsharpsans"
                    android:text="@string/wings_account_title"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/wings_account_sign_in_hint"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/federation_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_xray_routing_field"
                    android:gravity="center_vertical"
                    android:hint="@string/wings_account_login_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/federation_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_xray_routing_field"
                    android:gravity="center_vertical"
                    android:hint="@string/wings_account_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/federation_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@drawable/bg_xray_routing_field"
                    android:gravity="center_vertical"
                    android:hint="@string/wings_account_code_hint"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/federation_sign_in_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <!-- Кнопка со своим индикатором: вход идёт по сети, и молчащая
                     кнопка выглядит как будто нажатие потерялось -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/federation_sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/wings_account_sign_in" />

                    <ProgressBar
                        android:id="@+id/federation_sign_in_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="20dp"
                        android:visibility="gone" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/federation_sign_in_matrix"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_matrix"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:text="@string/wings_account_sign_in_matrix" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- Шапка профиля: имя слева, аватар справа -->
            <LinearLayout
                android:id="@+id/federation_profile_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="22dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/federation_username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/samsungsharpsans"
                    android:maxLines="1"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp">

                    <ImageView
                        android:id="@+id/federation_avatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/wings_account_change_avatar"
                        android:src="@drawable/ic_account_avatar" />

                </FrameLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/federation_access_progress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <!-- Счётчики: по карточке на величину, одинаковой высоты -->
            <LinearLayout
                android:id="@+id/federation_counters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:measureWithLargestChild="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wings_account_nodes_caption"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />

                        <TextView
                            android:id="@+id/federation_nodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?android:attr/textAppearanceLarge"
                            android:textColor="?android:textColorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/federation_nodes_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/federation_traffic_caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wings_account_traffic_caption"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />

                        <TextView
                            android:id="@+id/federation_traffic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?android:attr/textAppearanceLarge"
                            android:textColor="?android:textColorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wings_account_period_caption"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:textColorSecondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Приём и отдача по своей карточке: одной цифрой канал не описать -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:measureWithLargestChild="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_arrow_down"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/traffic_rx"
                            android:text="@string/traffic_downlink"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/traffic_rx" />

                        <TextView
                            android:id="@+id/federation_speed_down"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?android:attr/textAppearanceLarge"
                            android:textColor="?android:textColorPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_arrow_up"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/traffic_tx"
                            android:text="@string/traffic_uplink"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/traffic_tx" />

                        <TextView
                            android:id="@+id/federation_speed_up"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?android:attr/textAppearanceLarge"
                            android:textColor="?android:textColorPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Доверие: полоса читается так же, как полоса трафика -->
                <FrameLayout
                    android:id="@+id/federation_trust_bar"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/federation_trust_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:minHeight="34dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_profile_quota" />

                    <TextView
                        android:id="@+id/federation_trust"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:shadowColor="#B3000000"
                        android:shadowRadius="4"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Разделы: у каждого своя активити -->
            <LinearLayout
                android:id="@+id/federation_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="?android:colorBackground"
                    android:orientation="vertical"
                    app:roundedCorners="all">

                    <dev.oneuiproject.oneui.widget.CardItemView
                        android:id="@+id/federation_row_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_account_profile_round"
                        app:showBottomDivider="true"
                        app:showTopDivider="false"
                        app:summary="@string/federation_row_profile_summary"
                        app:title="@string/federation_row_profile_title" />

                    <dev.oneuiproject.oneui.widget.CardItemView
                        android:id="@+id/federation_row_subscription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_account_subscription_round"
                        app:showBottomDivider="true"
                        app:showTopDivider="false"
                        app:summary="@string/federation_row_subscription_summary"
                        app:title="@string/federation_row_subscription_title" />

                    <dev.oneuiproject.oneui.widget.CardItemView
                        android:id="@+id/federation_row_invites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_account_invites_round"
                        app:showBottomDivider="false"
                        app:showTopDivider="false"
                        app:summary="@string/federation_row_invites_summary"
                        app:title="@string/federation_row_invites_title" />
                </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

                <!-- Разделы панели: видны тем, кому она открыта -->
                <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                    android:id="@+id/federation_panel_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?android:colorBackground"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:roundedCorners="all">

                    <dev.oneuiproject.oneui.widget.CardItemView
                        android:id="@+id/federation_row_donor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_account_donor_round"
                        app:showBottomDivider="true"
                        app:showTopDivider="false"
                        app:summary="@string/federation_row_donor_summary"
                        app:title="@string/federation_row_donor_title" />

                    <dev.oneuiproject.oneui.widget.CardItemView
                        android:id="@+id/federation_row_clients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_account_clients_round"
                        app:showBottomDivider="false"
                        app:showTopDivider="false"
                        app:summary="@string/federation_row_clients_summary"
                        app:title="@string/federation_row_clients_title" />
                </dev.oneuiproject.oneui.widget.RoundedLinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/federation_sign_out"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:minWidth="220dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:drawableStart="@drawable/ic_account_sign_out"
                android:drawablePadding="10dp"
                android:text="@string/wings_account_sign_out"
                android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/federation_sign_out_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="18dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</dev.oneuiproject.oneui.layout.ToolbarLayout>
