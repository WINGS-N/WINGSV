<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?roundedCornerColor"
    app:expanded="false"
    app:expandable="false"
    app:title="@string/federation_account_title">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Вход: поля, кнопка, Matrix ссылкой под ней -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/federation_sign_in_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp"
                app:roundedCorners="all">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/federation_account_sign_in_title"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/federation_account_sign_in_hint"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/federation_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_xray_routing_field"
                    android:gravity="center_vertical"
                    android:hint="@string/federation_account_login_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLength="64"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/federation_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_xray_routing_field"
                    android:gravity="center_vertical"
                    android:hint="@string/federation_account_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLength="512"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />

                <!-- Поле кода появляется, только когда панель его спросила -->
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/federation_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@drawable/bg_xray_routing_field"
                    android:gravity="center_vertical"
                    android:hint="@string/federation_account_code_hint"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="16"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/federation_sign_in_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/federation_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/federation_account_sign_in" />

                <TextView
                    android:id="@+id/federation_sign_in_matrix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="@string/federation_account_sign_in_matrix"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- Профиль: имя слева, аватар справа -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/federation_profile_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone"
                app:roundedCorners="all">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/federation_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/federation_trust"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:textColorSecondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/federation_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_account_avatar" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- Доступ и подписка -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/federation_access_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?android:colorBackground"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                app:roundedCorners="all">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/federation_account_access_title"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/federation_nodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/federation_subscription_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/federation_subscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_xray_routing_field"
                    android:fontFamily="monospace"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/federation_apply_subscription"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/federation_account_apply_subscription" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/federation_sign_out_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?android:colorBackground"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                app:roundedCorners="all">

                <TextView
                    android:id="@+id/federation_sign_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="10dp"
                    android:text="@string/federation_account_sign_out"
                    android:textColor="?attr/colorError"
                    android:textSize="16sp" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>
        </LinearLayout>
    </ScrollView>
</dev.oneuiproject.oneui.layout.ToolbarLayout>
