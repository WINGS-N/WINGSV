<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?roundedCornerColor"
    app:expanded="false"
    app:expandable="false"
    app:title="@string/federation_row_invites_title">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Свой код: его показывают с экрана, а снимают чужой камерой -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/invite_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                app:roundedCorners="all">

                <TextView
                    android:id="@+id/invite_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/federation_invites_hint"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <FrameLayout
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp">

                    <!-- Скелетон под QR: пока код едет, на его месте стоит блок,
                         а не пустота, и экран не прыгает когда код приезжает -->
                    <FrameLayout
                        android:id="@+id/invite_qr_skeleton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_skeleton_block">

                        <ProgressBar
                            android:id="@+id/invite_qr_loader"
                            style="?android:attr/progressBarStyleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/invite_qr_frame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <dev.oneuiproject.oneui.widget.QRImageView
                            android:id="@+id/invite_qr"
                            android:layout_width="210dp"
                            android:layout_height="210dp"
                            android:padding="6dp" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/invite_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textIsSelectable="true"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/invite_uses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/invite_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/invite_create"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/federation_invites_create" />

                    <ProgressBar
                        android:id="@+id/invite_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="20dp"
                        android:visibility="gone" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/invite_share"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/federation_invites_share"
                    android:visibility="gone" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/federation_invites_redeem_section" />

            <!-- Чужой код: вводится руками или снимается камерой -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/invite_redeem_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical"
                android:padding="24dp"
                app:roundedCorners="all">

                <!-- Строка состояния появляется только когда есть что сказать:
                     пустой TextView оставлял дыру над полем -->
                <TextView
                    android:id="@+id/invite_redeem_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/invite_redeem_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_xray_routing_field"
                    android:digits="0123456789ABCDEFabcdef"
                    android:gravity="center_vertical"
                    android:hint="@string/federation_invites_code_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp" />

                <!-- Своя ошибка у кода: чужая, в блоке приглашения, читается как
                     поломка приглашения, а не набранного кода -->
                <TextView
                    android:id="@+id/invite_redeem_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <!-- Крутилка стоит на своей кнопке: на чужой человек не понимает,
                     что вообще происходит -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/invite_redeem"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/federation_invites_redeem" />

                    <ProgressBar
                        android:id="@+id/invite_redeem_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="20dp"
                        android:visibility="gone" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/invite_scan"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_qr_scanner"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:text="@string/federation_invites_scan" />
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>
        </LinearLayout>
    </ScrollView>
</dev.oneuiproject.oneui.layout.ToolbarLayout>
