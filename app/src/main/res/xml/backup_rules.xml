<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup for devices below API 31. Settings and VPN profiles are worth carrying
   to a new device, so the MMKV stores are included deliberately rather than by
   default. The Guardian client token travels with them: it is bound to the
   device's HWID panel-side, so a restore elsewhere cannot use it until an admin
   rotates the token, which releases the binding.
-->
<full-backup-content>
    <include domain="file" path="mmkv/" />
    <include domain="file" path="byedpi_domain_lists.json" />
    <include domain="sharedpref" path="." />
    <!-- Runtime scratch: rebuilt on next launch, restoring it only revives stale state. -->
    <exclude domain="file" path="mmkv/wingsv_runtime_state" />
    <exclude domain="file" path="mmkv/wingsv_xray_runtime" />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
