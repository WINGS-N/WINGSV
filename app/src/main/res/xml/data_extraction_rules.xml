<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+ backup. Cloud backup and device transfer carry the same set: settings
   and VPN profiles are the point of having a backup at all. See backup_rules.xml
   for why the Guardian credential is safe to carry.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="mmkv/" />
        <include domain="file" path="byedpi_domain_lists.json" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="mmkv/wingsv_runtime_state" />
        <exclude domain="file" path="mmkv/wingsv_xray_runtime" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="mmkv/" />
        <include domain="file" path="byedpi_domain_lists.json" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="mmkv/wingsv_runtime_state" />
        <exclude domain="file" path="mmkv/wingsv_xray_runtime" />
    </device-transfer>
</data-extraction-rules>
